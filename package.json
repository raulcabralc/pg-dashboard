{
  "name": "pg-dashboard",
  "version": "0.1.2",
  "description": "Plug-and-play PostgreSQL dashboard middleware for Express.",
  "main": "backend/index.js",
  "types": "backend/index.d.ts",
  "typesVersions": {
    "*": {
      "nestjs": [
        "backend/nestjs.d.ts"
      ],
      "*": [
        "backend/index.d.ts"
      ]
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/raulcabralc/pg-dashboard.git"
  },
  "homepage": "https://docs.raulc.dev/docs/pg-dashboard",
  "bugs": {
    "url": "https://github.com/raulcabralc/pg-dashboard/issues"
  },
  "exports": {
    ".": {
      "types": "./backend/index.d.ts",
      "require": "./backend/index.js",
      "default": "./backend/index.js"
    },
    "./nestjs": {
      "types": "./backend/nestjs.d.ts",
      "require": "./backend/nestjs.js",
      "default": "./backend/nestjs.js"
    }
  },
  "files": [
    "backend",
    "examples",
    "frontend/dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node --test",
    "build": "npm --prefix frontend run build",
    "pack:check": "npm test && npm run build && npm pack --dry-run",
    "prepublishOnly": "npm test && npm run build",
    "example": "node examples/basic-server.js"
  },
  "keywords": [
    "postgres",
    "express",
    "dashboard",
    "crud",
    "reports",
    "middleware",
    "admin",
    "nestjs",
    "nest"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=18"
  },
  "peerDependencies": {
    "@nestjs/common": ">=9.0.0",
    "express": ">=4.18.0"
  },
  "peerDependenciesMeta": {
    "@nestjs/common": {
      "optional": true
    }
  },
  "dependencies": {
    "dotenv": "^17.4.2",
    "pg": "^8.11.5"
  },
  "devDependencies": {
    "express": "^4.18.3"
  }
}
